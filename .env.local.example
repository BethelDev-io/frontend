# ---------------------------------------------------------------------------
# Soroban RPC configuration (server-side only)
# ---------------------------------------------------------------------------
# Comma-separated list of Soroban RPC endpoints. The server-side RPC client
# tracks per-provider health, fails over automatically, and circuit-breaks
# providers that repeatedly error. Order is the failover preference order.
# Production builds fail fast if this is missing or empty.
SOROBAN_RPC_URLS=https://soroban-testnet.stellar.org

# Soroban network passphrase used to build/verify transactions.
SOROBAN_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Bounded concurrency for batched vault list / multi-vault balance reads.
SOROBAN_RPC_MAX_CONCURRENCY=4

# Retry policy for read-only RPC calls (bounded attempts, exponential
# backoff with jitter). Signed transactions are never re-submitted.
SOROBAN_RPC_MAX_ATTEMPTS=3
SOROBAN_RPC_BASE_BACKOFF_MS=200
SOROBAN_RPC_MAX_BACKOFF_MS=2000

# Circuit breaker: consecutive errors before a provider is tripped, and how
# long (ms) it stays open before a half-open probe is allowed.
SOROBAN_RPC_CIRCUIT_THRESHOLD=5
SOROBAN_RPC_CIRCUIT_COOLDOWN_MS=30000

# Read-after-write: how long (ms) to wait for ledger inclusion and re-read
# affected state before responding with a 'pending confirmation' status.
SOROBAN_RPC_CONFIRMATION_TIMEOUT_MS=15000
