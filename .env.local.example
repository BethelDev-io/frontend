NEXT_PUBLIC_API_URL=http://localhost:8081

# Soroban RPC endpoints used by /contracts for the live WASM-hash check.
# Unset falls back to the public defaults in src/lib/soroban/networks.ts.
# NEXT_PUBLIC_SOROBAN_RPC_TESTNET=https://soroban-testnet.stellar.org
# NEXT_PUBLIC_SOROBAN_RPC_FUTURENET=
# NEXT_PUBLIC_SOROBAN_RPC_MAINNET=

# Override the contract registry's deployments. Same shape as a per-network
# deployments map in src/lib/soroban/registry.ts, keyed by network then by
# contract key. Note this changes what /contracts checks against — it is a
# deployment fact, not a trust anchor.
# NEXT_PUBLIC_ZENITH_DEPLOYMENTS={"testnet":{"options_market":{"contractId":"C...","wasmHash":"...","version":"1.0.0","sourceCommit":"...","auditReportUrl":null,"upgradeable":true,"upgradeHistory":[]}}}
# Backend per environment mode (src/lib/env/networks.ts). A mode with no URL
# is still selectable but refuses to make API calls rather than falling back
# to another mode's backend.
NEXT_PUBLIC_API_URL=http://localhost:8081           # paper trading (default mode)
# NEXT_PUBLIC_TESTNET_API_URL=
# NEXT_PUBLIC_MAINNET_API_URL=

# Public origin of this frontend — used for absolute share/OG URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-only secret (>= 32 chars) that signs share-card links. Never
# prefix with NEXT_PUBLIC_. Generate with: openssl rand -base64 48
SHARE_SIGNING_SECRET=

# Soroban on-chain integration (closes #68, #70, #71)
# Set NEXT_PUBLIC_ENABLE_ONCHAIN=true to enable on-chain trading via the Soroban pipeline.
# Without this flag the app routes all trades through the paper-trading backend API (default).
NEXT_PUBLIC_ENABLE_ONCHAIN=false

# Select the Stellar network used by the app: testnet or mainnet.
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Soroban RPC endpoint for the selected network.
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Horizon endpoint — used for account info fallback
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org

# Stellar contract IDs are public C... StrKeys; leave unset until deployed.
NEXT_PUBLIC_STELLAR_TESTNET_CONTRACT_ID=
NEXT_PUBLIC_STELLAR_MAINNET_CONTRACT_ID=
NEXT_PUBLIC_ZENITH_CONTRACT_ID=

# Zenith options contract address on your target network
NEXT_PUBLIC_OPTIONS_CONTRACT=CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC

# Build metadata is supplied by release automation; local builds use defaults.
NEXT_PUBLIC_APP_VERSION=0.1.0
NEXT_PUBLIC_BUILD_SHA=local

# Sentry error monitoring (Issue #106)
# Get your DSN from https://sentry.io → Project → Settings → Client Keys
NEXT_PUBLIC_SENTRY_DSN=
# CI-only — source map upload
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# NODE_ENV is set by Next.js for dev/build/start and normally should not be overridden.

# Feature flags
# URL for the remote JSON config (optional — falls back to safe defaults)
# NEXT_PUBLIC_FLAGS_URL=https://your-cdn.example.com/flags/config.json
# FLAGS_CONFIG_URL=https://your-cdn.example.com/flags/config.json  # server-only (more secure)

# Enable the real paginated history endpoint (client adapter used when unset)
# NEXT_PUBLIC_HISTORY_PAGINATION=1

# Per-flag env overrides — set to "1" or "true" to force a flag on
# These outrank remote config and are baked in at build time. Leave
# NEXT_PUBLIC_FLAG_VAULTS unset in staging and production so the remote-config
# kill switch works. See docs/feature-flag-rollout.md.
# NEXT_PUBLIC_FLAG_SOROBAN_EXECUTION=1
# NEXT_PUBLIC_FLAG_GOVERNANCE=1
# NEXT_PUBLIC_FLAG_VAULTS=1
# NEXT_PUBLIC_FLAG_NEW_ORDER_TYPES=1
# NEXT_PUBLIC_FLAG_PORTFOLIO_SCENARIOS=1
# NEXT_PUBLIC_FLAG_ADVANCED_ANALYTICS=1

# ---------------------------------------------------------------------------
# Internal service-to-service trust (Issue #289)
# ---------------------------------------------------------------------------
# These values are REFERENCES into a managed secret store (Vault / AWS Secrets
# Manager / GCP Secret Manager), never the secret material itself. Do not paste
# real tokens, private keys, or certificates here. The backend resolves each
# reference at boot and fails closed if it cannot.
#
# Local dev bypass: set SERVICE_AUTH_DEV_BYPASS=true to skip mTLS and signed
# service tokens on localhost only. src/env.ts refuses to boot in production
# when this is enabled, so it cannot leak into a deployed environment.
SERVICE_AUTH_DEV_BYPASS=false

# Managed-store references for the mTLS material used between internal
# services (BFF, API, indexer, scheduler, keeper).
# SERVICE_MTLS_CA_REF=secret://vault-stack/internal-ca
# SERVICE_MTLS_CERT_REF=secret://vault-stack/bff-client-cert
# SERVICE_MTLS_KEY_REF=secret://vault-stack/bff-client-key

# Short-lived signed service tokens. Each service gets its own signing key
# reference and a narrow scope claim; tokens rotate and are never shared.
# SERVICE_TOKEN_TTL_SECONDS=300
# SERVICE_TOKEN_CLOCK_SKEW_SECONDS=30
# SERVICE_TOKEN_BFF_SIGNING_KEY_REF=secret://vault-stack/bff-token-key
# SERVICE_TOKEN_API_SIGNING_KEY_REF=secret://vault-stack/api-token-key
# SERVICE_TOKEN_INDEXER_SIGNING_KEY_REF=secret://vault-stack/indexer-token-key
# SERVICE_TOKEN_SCHEDULER_SIGNING_KEY_REF=secret://vault-stack/scheduler-token-key
# SERVICE_TOKEN_KEEPER_SIGNING_KEY_REF=secret://vault-stack/keeper-token-key

# Egress allowlist — outbound destinations internal services may reach.
# Anything not listed is denied and logged/alerted. Comma-separated hosts.
# EGRESS_ALLOWLIST=soroban-testnet.stellar.org,horizon-testnet.stellar.org,api.coingecko.com,api.resend.com
