{
  "$schema": "./perf-thresholds.schema.json",
  "version": 1,
  "description": "Regression thresholds for the Zenith frontend performance harness. A CI run fails if any metric in any scenario regresses by more than `defaultThreshold`. Per-scenario and per-metric overrides are supported.",
  "defaultThreshold": 0.2,
  "scenarios": {
    "spot-tick": {
      "commitCount":    { "threshold": 0.05,  "note": "Commit count on spot ticks should be very stable" },
      "totalRenderMs":  { "threshold": 0.20 },
      "p95RenderMs":    { "threshold": 0.20 },
      "totalLongTaskMs":{ "threshold": null,  "note": "Any long task on a spot tick is a regression regardless of baseline" }
    },
    "chain-update": {
      "commitCount":    { "threshold": 0.10 },
      "totalRenderMs":  { "threshold": 0.20 },
      "p95RenderMs":    { "threshold": 0.20 },
      "totalLongTaskMs":{ "threshold": null }
    },
    "position-mtm": {
      "commitCount":    { "threshold": 0.10 },
      "totalRenderMs":  { "threshold": 0.20 },
      "p95RenderMs":    { "threshold": 0.25,  "note": "Slightly more lenient — MTM rows vary more between runs" },
      "totalLongTaskMs":{ "threshold": null }
    },
    "tab-switch": {
      "commitCount":    { "threshold": 0.10 },
      "totalRenderMs":  { "threshold": 0.20 },
      "p95RenderMs":    { "threshold": 0.30,  "note": "Tab switch mounts/unmounts heavy panels; more variance expected" },
      "totalLongTaskMs":{ "threshold": null }
    },
    "vault-list-render": {
      "commitCount":    { "threshold": 0.15 },
      "totalRenderMs":  { "threshold": 0.20,  "note": "Vault listing cold-render — 4 cards, Fast 3G" },
      "p95RenderMs":    { "threshold": 0.25 },
      "totalLongTaskMs":{ "threshold": null }
    },
    "vault-detail-render": {
      "commitCount":    { "threshold": 0.15 },
      "totalRenderMs":  { "threshold": 0.20,  "note": "Vault detail page with epoch timeline and sidebar" },
      "p95RenderMs":    { "threshold": 0.25 },
      "totalLongTaskMs":{ "threshold": null }
    },
    "epoch-transition": {
      "commitCount":    { "threshold": 0.10 },
      "totalRenderMs":  { "threshold": 0.15,  "note": "Epoch phase change re-render must stay tight" },
      "p95RenderMs":    { "threshold": 0.15 },
      "totalLongTaskMs":{ "threshold": 0,     "note": "Zero long tasks allowed during epoch transition" }
    },
    "withdrawal-queue-render": {
      "commitCount":    { "threshold": 0.15 },
      "totalRenderMs":  { "threshold": 0.20,  "note": "50-item withdrawal queue list render" },
      "p95RenderMs":    { "threshold": 0.25 },
      "totalLongTaskMs":{ "threshold": null }
    }
  }
}
